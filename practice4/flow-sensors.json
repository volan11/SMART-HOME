[
  {
    "id": "tab_sensors",
    "type": "tab",
    "label": "Датчики офиса",
    "disabled": false,
    "info": "TEMP-01 и HUM-01 раз в 5 секунд отправляют показания на приёмник CTRL-01:8080/api/readings. Без узлов Function."
  },
  {
    "id": "inj_temp",
    "type": "inject",
    "z": "tab_sensors",
    "name": "TEMP-01 каждые 5 с",
    "props": [
      {
        "p": "payload",
        "v": "$round($random() * 1500 + 20000) / 1000",
        "vt": "jsonata"
      },
      {
        "p": "timestamp",
        "v": "",
        "vt": "date"
      }
    ],
    "repeat": "5",
    "crontab": "",
    "once": true,
    "onceDelay": 1,
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 190,
    "y": 140,
    "wires": [
      [
        "chg_temp"
      ]
    ]
  },
  {
    "id": "chg_temp",
    "type": "change",
    "z": "tab_sensors",
    "name": "Собрать чтение TEMP-01",
    "rules": [
      {
        "t": "set",
        "p": "reading.value",
        "pt": "msg",
        "to": "payload",
        "tot": "msg"
      },
      {
        "t": "set",
        "p": "reading.sensor_id",
        "pt": "msg",
        "to": "TEMP-01",
        "tot": "str"
      },
      {
        "t": "set",
        "p": "reading.zone",
        "pt": "msg",
        "to": "server_room",
        "tot": "str"
      },
      {
        "t": "set",
        "p": "reading.timestamp",
        "pt": "msg",
        "to": "timestamp",
        "tot": "msg"
      },
      {
        "t": "set",
        "p": "reading.unit",
        "pt": "msg",
        "to": "C",
        "tot": "str"
      },
      {
        "t": "set",
        "p": "payload",
        "pt": "msg",
        "to": "reading",
        "tot": "msg"
      },
      {
        "t": "set",
        "p": "headers",
        "pt": "msg",
        "to": "{\"Content-Type\":\"application/json\"}",
        "tot": "json"
      }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "x": 470,
    "y": 140,
    "wires": [
      [
        "http_temp"
      ]
    ]
  },
  {
    "id": "http_temp",
    "type": "http request",
    "z": "tab_sensors",
    "name": "POST на приёмник (CTRL)",
    "method": "POST",
    "ret": "txt",
    "paytoqs": "ignore",
    "url": "http://192.168.20.20:8080/api/readings",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": [],
    "x": 760,
    "y": 140,
    "wires": [
      [
        "dbg_temp"
      ]
    ]
  },
  {
    "id": "dbg_temp",
    "type": "debug",
    "z": "tab_sensors",
    "name": "Ответ приёмника (TEMP-01)",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 1030,
    "y": 140,
    "wires": []
  },
