[
  {
    "id": "tab_office",
    "type": "tab",
    "label": "Умный офис: датчики и вентилятор",
    "disabled": false,
    "info": "Всё отправляется только вручную. В узлах inject вписываешь нужное значение и жмёшь квадратик слева. При температуре больше 30 вентилятор FAN-01 получает ON, иначе OFF."
  },
  {
    "id": "inj_temp",
    "type": "inject",
    "z": "tab_office",
    "name": "Температура TEMP-01 (впиши число)",
    "props": [
      {
        "p": "payload",
        "v": "25",
        "vt": "num"
      },
      {
        "p": "timestamp",
        "v": "",
        "vt": "date"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 250,
    "y": 120,
    "wires": [
      [
        "chg_temp"
      ]
    ]
  },
  {
    "id": "chg_temp",
    "type": "change",
    "z": "tab_office",
    "name": "Собрать чтение TEMP-01",
    "rules": [
      {
        "t": "set",
        "p": "reading.value",
        "pt": "msg",
        "to": "payload",
        "tot": "msg"
      },
      {
        "t": "set",
        "p": "reading.sensor_id",
        "pt": "msg",
        "to": "TEMP-01",
        "tot": "str"
      },
      {
        "t": "set",
        "p": "reading.zone",
        "pt": "msg",
        "to": "server_room",
        "tot": "str"
      },
      {
        "t": "set",
        "p": "reading.timestamp",
        "pt": "msg",
        "to": "timestamp",
        "tot": "msg"
      },
      {
        "t": "set",
        "p": "reading.unit",
        "pt": "msg",
        "to": "C",
        "tot": "str"
      },
      {
        "t": "set",
        "p": "payload",
        "pt": "msg",
        "to": "reading",
        "tot": "msg"
      },
      {
        "t": "set",
        "p": "headers",
        "pt": "msg",
        "to": "{\"Content-Type\":\"application/json\"}",
        "tot": "json"
      }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "x": 540,
    "y": 120,
    "wires": [
      [
        "http_reading",
        "sw_temp"
      ]
    ]
  },
  {
    "id": "http_reading",
    "type": "http request",
    "z": "tab_office",
    "name": "POST показание (CTRL)",
    "method": "POST",
    "ret": "txt",
    "paytoqs": "ignore",
    "url": "http://192.168.20.20:8080/api/readings",
    "tls": "",
