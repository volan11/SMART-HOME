  {
    "id": "sw_temp",
    "type": "switch",
    "z": "tab_office",
    "name": "Температура больше 30?",
    "property": "payload.value",
    "propertyType": "msg",
    "rules": [
      {
        "t": "gt",
        "v": "30",
        "vt": "num"
      },
      {
        "t": "else"
      }
    ],
    "checkall": "true",
    "repair": false,
    "outputs": 2,
    "x": 820,
    "y": 240,
    "wires": [
      [
        "chg_fan_on"
      ],
      [
        "chg_fan_off"
      ]
    ]
  },
